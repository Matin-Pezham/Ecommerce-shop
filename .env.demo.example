# Demo production build configuration.
# Produces a production build (npm run build) that showcases the app with
# mock API/auth data instead of a real backend. Demo mode is ONLY active
# when VITE_APP_MODE=demo is set explicitly; a production build with no
# VITE_APP_MODE defaults to real production and requires a live API.
#
# Copy to .env.production.local (or configure these values in your hosting
# provider) before building. Never commit the real file.

VITE_APP_NAME=Northstar Commerce
VITE_APP_MODE=demo
VITE_ENABLE_MOCK_API=true
VITE_ENABLE_MOCK_AUTH=true
# VITE_API_BASE_URL is not required in demo mode; MSW intercepts all API calls.
