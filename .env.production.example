# Real production configuration.
# Requires a live API URL and disables all mocks. Copy to
# .env.production.local (or configure these values in your hosting
# provider) before building. Never commit the real file.

VITE_APP_NAME=Northstar Commerce
VITE_APP_MODE=production
VITE_API_BASE_URL=https://api.your-domain.com
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_MOCK_AUTH=false
